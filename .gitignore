# Ambiente virtual
.venv/
venv/
env/

# Variáveis de ambiente
.env

# Dataset (arquivos grandes — não versionar; ver slm/generate_dataset.py para
# regenerar o sintético, e o Hugging Face Hub para o dataset real)
dataset/train/images/*
dataset/train/labels/*
dataset/val/images/*
dataset/val/labels/*
dataset/raw_images/*
dataset/synthetic/images/*
dataset/synthetic/labels/*
dataset/synthetic/florence2/*
dataset/synthetic/*.zip

# Pesos dos modelos — exceto os best.pt finais, que SÃO versionados de
# propósito: são os artefatos que a API carrega para rodar a demo sem
# precisar retreinar/baixar nada (22MB + 20MB, bem dentro do limite do
# GitHub). stride_yolov8s = componentes; stride_yolo11_pose = fluxos/setas
# (modelo publicado pelo autor do dataset — ver Referências no README).
slm/weights/*
!slm/weights/stride_yolov8s/
slm/weights/stride_yolov8s/*
!slm/weights/stride_yolov8s/best.pt
!slm/weights/stride_yolo11_pose/
slm/weights/stride_yolo11_pose/*
!slm/weights/stride_yolo11_pose/best.pt

# Manter os .gitkeep
!**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Jupyter — ignora notebooks em geral, exceto o notebook de treino com os
# outputs reais do Kaggle (evidência de execução, não só código-fonte)
.ipynb_checkpoints/
*.ipynb
!slm/notebook-stride-architecture-components.ipynb

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs e relatórios gerados
*.log
report/output/
reports/output/

# Arquivos temporários do diagrams/graphviz
*.dot

# Arquivo de trabalho para passar mensagem de commit multi-linha via
# `git commit -F` (evita o bug de bracketed-paste do terminal) — não faz
# parte do projeto em si.
commit_msg.txt

# Arquiteturas de teste extraídas do PDF da FIAP — usadas só localmente
# para validar o pipeline (Task 15), não fazem parte do código-fonte.
docs/fiap_test_architectures/
